# Bus Passenger Demand Forecasting - Environment Configuration
# Copy this file to .env and adjust variables as needed

# Application Environment (development, staging, production)
APP_ENV=development

# FastAPI Service Configuration
API_HOST=127.0.0.1
API_PORT=8000
API_URL=http://127.0.0.1:8000

# Path to trained model joblib artifact
MODEL_PATH=models/bus_demand_model.joblib

# Synthetic Dataset Configuration
DATA_PATH=data/synthetic_trips.csv
RANDOM_SEED=42
SIMULATION_DAYS=180

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
